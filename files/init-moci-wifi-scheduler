#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=0
CRON='/usr/sbin/moci-wifi-scheduler'
start() {
  mkdir -p /etc/crontabs
  touch /etc/crontabs/root
  grep -Fq "$CRON" /etc/crontabs/root ||
    printf '* * * * * %s\n' "$CRON" >> /etc/crontabs/root
  /etc/init.d/cron enable >/dev/null 2>&1 || :
  /etc/init.d/cron restart >/dev/null 2>&1 || :
}
stop() {
  [ -f /etc/crontabs/root ] || return 0
  sed -i '\|/usr/sbin/moci-wifi-scheduler|d' /etc/crontabs/root
  /etc/init.d/cron restart >/dev/null 2>&1 || :
}

