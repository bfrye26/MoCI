{
  "moci-docker-viewer": {
    "description": "Read Docker inventories through restricted adapter",
    "read": {
      "ubus": {
        "moci-docker": [
          "status",
          "containers",
          "stacks",
          "images",
          "volumes",
          "networks",
          "storage",
          "logs",
          "catalog",
          "managed_stacks"
        ]
      }
    }
  },
  "moci-docker-deployer": {
    "description": "Explicitly approved template and managed stack operations",
    "write": {
      "ubus": {
        "moci-docker": [
          "deploy",
          "install_catalog",
          "stack_action",
          "container_action",
          "prepare_app"
        ]
      }
    }
  }
}
