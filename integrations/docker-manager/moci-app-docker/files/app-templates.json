{
  "schema": 1,
  "templates": {
    "uptime-kuma": {
      "image": "louislam/uptime-kuma:2",
      "repository": "louislam/uptime-kuma",
      "ports": [
        "3001:3001"
      ],
      "volumes": [
        "uptime-kuma-data:/app/data"
      ],
      "description": "Uptime Kuma v2 with persistent SQLite data, preinitialized named volume and non-root UID 1000.",
      "path": "http://ROUTER_IP:3001/",
      "needs_write_access": true,
      "volume_initializer": {
        "path": "/app/data",
        "uid": 1000,
        "gid": 1000
      },
      "run_as_user": "1000:1000"
    },
    "it-tools": {
      "image": "corentinth/it-tools:latest",
      "repository": "corentinth/it-tools",
      "ports": [
        "8081:80"
      ],
      "volumes": [],
      "description": "IT Tools over LAN TCP 8081. Nginx runs without host privileges and uses tightly scoped in-memory writable directories; the container root filesystem remains read-only.",
      "path": "http://ROUTER_IP:8081/",
      "needs_write_access": false,
      "tmpfs": [
        "/var/cache/nginx:uid=65534,gid=65534,mode=1777,size=16m",
        "/var/run:uid=65534,gid=65534,mode=1777,size=4m",
        "/tmp:uid=65534,gid=65534,mode=1777,size=16m"
      ]
    },
    "openspeedtest": {
      "image": "openspeedtest/latest:latest",
      "repository": "openspeedtest/latest",
      "ports": [
        "3000:3000",
        "3002:3001"
      ],
      "volumes": [],
      "description": "OpenSpeedTest LAN throughput test (HTTP 3000, HTTPS 3002). The upstream entrypoint edits Nginx configuration and runs crond; this reviewed profile requires a writable rootfs, root startup UID and a small fixed set of Linux capabilities. Only deploy trusted immutable image digests on a private LAN.",
      "path": "http://ROUTER_IP:3000/",
      "needs_write_access": true,
      "run_as_user": "0:0",
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER",
        "SETGID",
        "SETUID"
      ]
    },
    "cyberchef": {
      "image": "mpepping/cyberchef:latest",
      "repository": "mpepping/cyberchef",
      "ports": [
        "8000:8000"
      ],
      "volumes": [],
      "description": "Stateless CyberChef web utilities on LAN TCP 8000.",
      "path": "http://ROUTER_IP:8000/",
      "needs_write_access": false
    },
    "gotify": {
      "image": "gotify/server:2",
      "repository": "gotify/server",
      "ports": [
        "8084:8080"
      ],
      "volumes": [
        "gotify-data:/app/data"
      ],
      "description": "Gotify notifications on LAN port 8084; generated administrator password shown after first installation.",
      "path": "http://ROUTER_IP:8084/",
      "needs_write_access": true,
      "initial_password_env": "GOTIFY_DEFAULTUSER_PASS",
      "mem_limit": "384m",
      "environment": {
        "GOTIFY_SERVER_PORT": "8080"
      }
    },
    "memos": {
      "image": "neosmemo/memos:stable",
      "repository": "neosmemo/memos",
      "ports": [
        "5230:5230"
      ],
      "volumes": [
        "memos-data:/var/opt/memos"
      ],
      "description": "Private-by-default Memos with SQLite on a persistent named volume. The first user completes setup in the web UI.",
      "path": "http://ROUTER_IP:5230/",
      "needs_write_access": true,
      "volume_initializer": {
        "path": "/var/opt/memos",
        "uid": 10001,
        "gid": 10001
      },
      "run_as_user": "10001:10001",
      "environment": {
        "MEMOS_PORT": "5230",
        "MEMOS_DRIVER": "sqlite"
      }
    },
    "beszel": {
      "image": "henrygd/beszel:latest",
      "repository": "henrygd/beszel",
      "ports": [
        "8090:8090"
      ],
      "volumes": [
        "beszel-data:/beszel_data"
      ],
      "description": "Beszel monitoring hub only. Additional agents and host/Docker monitoring permissions are configured separately. First visit sets up the hub account.",
      "path": "http://ROUTER_IP:8090/",
      "needs_write_access": true,
      "mem_limit": "512m"
    },
    "grafana": {
      "image": "grafana/grafana:latest",
      "repository": "grafana/grafana",
      "ports": [
        "3010:3000"
      ],
      "volumes": [
        "grafana-data:/var/lib/grafana"
      ],
      "description": "Grafana analytics on LAN TCP 3010 with persistent storage. Initial administrator password is generated once during installation; store it securely.",
      "path": "http://ROUTER_IP:3010/",
      "needs_write_access": true,
      "run_as_user": "472:472",
      "volume_initializer": {
        "path": "/var/lib/grafana",
        "uid": 472,
        "gid": 472
      },
      "mem_limit": "768m",
      "initial_password_env": "GF_SECURITY_ADMIN_PASSWORD",
      "environment": {
        "GF_USERS_ALLOW_SIGN_UP": "false",
        "GF_AUTH_ANONYMOUS_ENABLED": "false"
      }
    },
    "audiobookshelf": {
      "repository": "ghcr.io/advplyr/audiobookshelf",
      "image": "ghcr.io/advplyr/audiobookshelf:latest",
      "ports": [
        "13378:80"
      ],
      "volumes": [
        "abs-config:/config",
        "abs-metadata:/metadata",
        "abs-audiobooks:/audiobooks",
        "abs-podcasts:/podcasts"
      ],
      "description": "Audiobookshelf server and first-user setup. Data, book and podcast libraries live in four dedicated Docker volumes; upload or copy media into those volumes separately.",
      "path": "http://ROUTER_IP:13378/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializers": [
        {
          "path": "/config",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/metadata",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/audiobooks",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/podcasts",
          "uid": 1000,
          "gid": 1000
        }
      ],
      "mem_limit": "768m",
      "environment": {
        "TZ": "Etc/UTC"
      }
    },
    "changedetection": {
      "repository": "ghcr.io/dgtlmoon/changedetection.io",
      "image": "ghcr.io/dgtlmoon/changedetection.io:latest",
      "ports": [
        "5000:5000"
      ],
      "volumes": [
        "changedetection-data:/datastore"
      ],
      "description": "Changedetection.io with persistent datastore and basic fetcher. LAN users can create monitored URLs; configure application authentication before granting access to untrusted clients.",
      "path": "http://ROUTER_IP:5000/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializer": {
        "path": "/datastore",
        "uid": 1000,
        "gid": 1000
      },
      "mem_limit": "768m",
      "environment": {
        "PORT": "5000"
      }
    },
    "gitea": {
      "repository": "docker.gitea.com/gitea",
      "image": "docker.gitea.com/gitea:28.3.0-rootless",
      "ports": [
        "3101:3000"
      ],
      "volumes": [
        "gitea-data:/var/lib/gitea",
        "gitea-config:/etc/gitea"
      ],
      "description": "Rootless Gitea with SQLite and persistent named volumes. Web installer and administrator account setup are completed on first visit. SSH repository access is not exposed by default.",
      "path": "http://ROUTER_IP:3101/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializers": [
        {
          "path": "/var/lib/gitea",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/etc/gitea",
          "uid": 1000,
          "gid": 1000
        }
      ],
      "mem_limit": "768m"
    },
    "homarr": {
      "repository": "ghcr.io/homarr-labs/homarr",
      "image": "ghcr.io/homarr-labs/homarr:latest",
      "ports": [
        "7575:7575"
      ],
      "volumes": [
        "homarr-appdata:/appdata"
      ],
      "description": "Homarr dashboard without Docker socket access. MoCI generates and preserves the application encryption key; complete initial account setup in the web UI.",
      "path": "http://ROUTER_IP:7575/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializer": {
        "path": "/appdata",
        "uid": 1000,
        "gid": 1000
      },
      "mem_limit": "768m",
      "generated_secret_env": "SECRET_ENCRYPTION_KEY"
    },
    "homepage": {
      "repository": "ghcr.io/gethomepage/homepage",
      "image": "ghcr.io/gethomepage/homepage:latest",
      "ports": [
        "3333:3000"
      ],
      "volumes": [
        "homepage-config:/app/config"
      ],
      "description": "Homepage dashboard with its allowed HTTP host set to this router's actual LAN address. No Docker socket is mounted; configured widgets must be added separately.",
      "path": "http://ROUTER_IP:3333/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializer": {
        "path": "/app/config",
        "uid": 1000,
        "gid": 1000
      },
      "mem_limit": "512m",
      "environment": {
        "HOMEPAGE_ALLOWED_HOSTS": "ROUTER_IP:3333",
        "PUID": "1000",
        "PGID": "1000"
      }
    },
    "jellyfin": {
      "repository": "jellyfin/jellyfin",
      "image": "jellyfin/jellyfin:latest",
      "ports": [
        "8096:8096"
      ],
      "volumes": [
        "jellyfin-config:/config",
        "jellyfin-cache:/cache",
        "jellyfin-media:/media"
      ],
      "description": "Jellyfin on LAN TCP 8096 with dedicated configuration, cache and empty media volumes. Complete its first-run wizard; transfer media into the managed volume to add libraries. No GPU access or UDP discovery.",
      "path": "http://ROUTER_IP:8096/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializers": [
        {
          "path": "/config",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/cache",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/media",
          "uid": 1000,
          "gid": 1000
        }
      ],
      "mem_limit": "1024m"
    },
    "prometheus": {
      "repository": "prom/prometheus",
      "image": "prom/prometheus:latest",
      "ports": [
        "9090:9090"
      ],
      "volumes": [
        "prometheus-data:/prometheus"
      ],
      "description": "Prometheus time-series server with its bundled default configuration. Exposes local monitoring UI on the trusted router LAN; scrape jobs are configured separately.",
      "path": "http://ROUTER_IP:9090/",
      "needs_write_access": false,
      "mem_limit": "768m",
      "volume_initializer": {
        "path": "/prometheus",
        "uid": 65534,
        "gid": 65534
      }
    },
    "tautulli": {
      "repository": "lscr.io/linuxserver/tautulli",
      "image": "lscr.io/linuxserver/tautulli:latest",
      "ports": [
        "8181:8181"
      ],
      "volumes": [
        "tautulli-config:/config"
      ],
      "description": "Tautulli web manager on LAN TCP 8181, with persistent settings. Plex server integration and Plex logging paths are configured after installation. This candidate requires runtime testing for LinuxServer non-root startup.",
      "path": "http://ROUTER_IP:8181/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializer": {
        "path": "/config",
        "uid": 1000,
        "gid": 1000
      },
      "environment": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "Etc/UTC"
      },
      "mem_limit": "512m"
    },
    "filebrowser": {
      "repository": "filebrowser/filebrowser",
      "image": "filebrowser/filebrowser:latest",
      "ports": [
        "8086:80"
      ],
      "volumes": [
        "filebrowser-files:/srv",
        "filebrowser-database:/database",
        "filebrowser-config:/config"
      ],
      "description": "File Browser with three private managed volumes for files, configuration and its user database. The image creates a first-run admin password, which should be retrieved from its Docker logs and immediately stored securely. No host filesystem access.",
      "path": "http://ROUTER_IP:8086/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializers": [
        {
          "path": "/srv",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/database",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/config",
          "uid": 1000,
          "gid": 1000
        }
      ],
      "mem_limit": "384m",
      "reviewed_risk": "sensitive-data"
    },
    "sftpgo": {
      "repository": "drakkan/sftpgo",
      "image": "drakkan/sftpgo:latest",
      "ports": [
        "8125:8080",
        "2022:2022"
      ],
      "volumes": [
        "sftpgo-data:/srv/sftpgo",
        "sftpgo-state:/var/lib/sftpgo"
      ],
      "description": "SFTPGo managed file-transfer server: LAN web interface TCP 8125 and SFTP TCP 2022. No WAN exposure. First administrator account is created in the web UI; default permissions apply to named private volumes only.",
      "path": "http://ROUTER_IP:8125/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializers": [
        {
          "path": "/srv/sftpgo",
          "uid": 1000,
          "gid": 1000
        },
        {
          "path": "/var/lib/sftpgo",
          "uid": 1000,
          "gid": 1000
        }
      ],
      "mem_limit": "512m",
      "reviewed_risk": "sensitive-data"
    },
    "n8n": {
      "repository": "docker.n8n.io/n8nio/n8n",
      "image": "docker.n8n.io/n8nio/n8n:latest",
      "ports": [
        "5678:5678"
      ],
      "volumes": [
        "n8n-data:/home/node/.n8n"
      ],
      "description": "n8n automation editor with SQLite and persistent encrypted credentials. The encryption key is generated and retained by MoCI. On the isolated trusted LAN, secure cookies are disabled for plain HTTP. Configure HTTPS and proper authentication before using real credentials or production webhooks.",
      "path": "http://ROUTER_IP:5678/",
      "needs_write_access": true,
      "run_as_user": "1000:1000",
      "volume_initializer": {
        "path": "/home/node/.n8n",
        "uid": 1000,
        "gid": 1000
      },
      "mem_limit": "1024m",
      "environment": {
        "N8N_SECURE_COOKIE": "false",
        "N8N_HOST": "ROUTER_IP",
        "N8N_PORT": "5678",
        "N8N_PROTOCOL": "http",
        "N8N_DIAGNOSTICS_ENABLED": "false",
        "N8N_PERSONALIZATION_ENABLED": "false"
      },
      "generated_secret_env": "N8N_ENCRYPTION_KEY",
      "reviewed_risk": "sensitive-data"
    },
    "ntfy": {
      "repository": "binwiederhier/ntfy",
      "image": "binwiederhier/ntfy:latest",
      "ports": [
        "8093:80"
      ],
      "volumes": [
        "ntfy-data:/var/lib/ntfy"
      ],
      "description": "ntfy local notification server over LAN TCP 8093, with persistent SQLite cache. Starts with read/write access for trusted LAN users only. Set authentication and user access rules before using it for private or untrusted notifications.",
      "path": "http://ROUTER_IP:8093/",
      "needs_write_access": true,
      "volume_initializer": {
        "path": "/var/lib/ntfy",
        "uid": 1000,
        "gid": 1000
      },
      "run_as_user": "1000:1000",
      "mem_limit": "384m",
      "command": [
        "serve"
      ],
      "environment": {
        "NTFY_BASE_URL": "http://ROUTER_IP:8093",
        "NTFY_LISTEN_HTTP": ":80",
        "NTFY_CACHE_FILE": "/var/lib/ntfy/cache.db",
        "NTFY_AUTH_DEFAULT_ACCESS": "read-write"
      }
    }
  }
}
