{
  "schema": 1,
  "templates": {
    "uptime-kuma": {
      "image": "louislam/uptime-kuma:2",
      "repository": "louislam/uptime-kuma",
      "ports": [
        "3001:3001"
      ],
      "volumes": [
        "uptime-kuma-data:/app/data"
      ],
      "description": "Uptime Kuma v2 with persistent SQLite data, preinitialized named volume and non-root UID 1000.",
      "path": "http://ROUTER_IP:3001/",
      "needs_write_access": true,
      "volume_initializer": {
        "path": "/app/data",
        "uid": 1000,
        "gid": 1000
      },
      "run_as_user": "1000:1000"
    },
    "it-tools": {
      "image": "corentinth/it-tools:latest",
      "repository": "corentinth/it-tools",
      "ports": [
        "8081:80"
      ],
      "volumes": [],
      "description": "IT Tools over LAN TCP 8081. Nginx runs without host privileges and uses tightly scoped in-memory writable directories; the container root filesystem remains read-only.",
      "path": "http://ROUTER_IP:8081/",
      "needs_write_access": false,
      "tmpfs": [
        "/var/cache/nginx:uid=65534,gid=65534,mode=1777,size=16m",
        "/var/run:uid=65534,gid=65534,mode=1777,size=4m",
        "/tmp:uid=65534,gid=65534,mode=1777,size=16m"
      ]
    },
    "openspeedtest": {
      "image": "openspeedtest/latest:latest",
      "repository": "openspeedtest/latest",
      "ports": [
        "3000:3000",
        "3002:3001"
      ],
      "volumes": [],
      "description": "OpenSpeedTest LAN throughput test (HTTP 3000, HTTPS 3002). The upstream entrypoint edits Nginx configuration and runs crond; this reviewed profile requires a writable rootfs, root startup UID and a small fixed set of Linux capabilities. Only deploy trusted immutable image digests on a private LAN.",
      "path": "http://ROUTER_IP:3000/",
      "needs_write_access": true,
      "run_as_user": "0:0",
      "cap_add": [
        "CHOWN",
        "DAC_OVERRIDE",
        "FOWNER",
        "SETGID",
        "SETUID"
      ]
    },
    "cyberchef": {
      "image": "mpepping/cyberchef:latest",
      "repository": "mpepping/cyberchef",
      "ports": [
        "8000:8000"
      ],
      "volumes": [],
      "description": "Stateless CyberChef web utilities on LAN TCP 8000.",
      "path": "http://ROUTER_IP:8000/",
      "needs_write_access": false
    },
    "gotify": {
      "image": "gotify/server:2",
      "repository": "gotify/server",
      "ports": [
        "8084:8080"
      ],
      "volumes": [
        "gotify-data:/app/data"
      ],
      "description": "Gotify notifications on LAN port 8084; generated administrator password shown after first installation.",
      "path": "http://ROUTER_IP:8084/",
      "needs_write_access": true,
      "initial_password_env": "GOTIFY_DEFAULTUSER_PASS",
      "mem_limit": "384m",
      "environment": {
        "GOTIFY_SERVER_PORT": "8080"
      }
    },
    "memos": {
      "image": "neosmemo/memos:stable",
      "repository": "neosmemo/memos",
      "ports": [
        "5230:5230"
      ],
      "volumes": [
        "memos-data:/var/opt/memos"
      ],
      "description": "Private-by-default Memos with SQLite on a persistent named volume. The first user completes setup in the web UI.",
      "path": "http://ROUTER_IP:5230/",
      "needs_write_access": true,
      "volume_initializer": {
        "path": "/var/opt/memos",
        "uid": 10001,
        "gid": 10001
      },
      "run_as_user": "10001:10001",
      "environment": {
        "MEMOS_PORT": "5230",
        "MEMOS_DRIVER": "sqlite"
      }
    },
    "beszel": {
      "image": "henrygd/beszel:latest",
      "repository": "henrygd/beszel",
      "ports": [
        "8090:8090"
      ],
      "volumes": [
        "beszel-data:/beszel_data"
      ],
      "description": "Beszel monitoring hub only. Additional agents and host/Docker monitoring permissions are configured separately. First visit sets up the hub account.",
      "path": "http://ROUTER_IP:8090/",
      "needs_write_access": true,
      "mem_limit": "512m"
    },
    "grafana": {
      "image": "grafana/grafana:latest",
      "repository": "grafana/grafana",
      "ports": [
        "3010:3000"
      ],
      "volumes": [
        "grafana-data:/var/lib/grafana"
      ],
      "description": "Grafana analytics on LAN TCP 3010 with persistent storage. Initial administrator password is generated once during installation; store it securely.",
      "path": "http://ROUTER_IP:3010/",
      "needs_write_access": true,
      "run_as_user": "472:472",
      "volume_initializer": {
        "path": "/var/lib/grafana",
        "uid": 472,
        "gid": 472
      },
      "mem_limit": "768m",
      "initial_password_env": "GF_SECURITY_ADMIN_PASSWORD",
      "environment": {
        "GF_USERS_ALLOW_SIGN_UP": "false",
        "GF_AUTH_ANONYMOUS_ENABLED": "false"
      }
    }
  }
}
