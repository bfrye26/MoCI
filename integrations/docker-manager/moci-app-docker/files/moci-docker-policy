#!/usr/bin/env python3
"""Root-only policy management for MoCI Docker RC testing.

No arbitrary tags, credentials, host mounts, or policy bypasses.
Images must be content-addressed Docker digests. Policy updates are atomic.
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT=Path('/etc/moci-docker')
IMAGE_RE=re.compile(r'^[A-Za-z0-9][A-Za-z0-9._/-]*@sha256:[0-9a-f]{64}$')
ID_RE=re.compile(r'^[a-z][a-z0-9-]{0,39}$')
APPROVAL=ROOT/'enable-deployments'

def fatal(msg):
    raise SystemExit('moci-docker-policy: '+msg)

def load(name):
    with (ROOT/name).open(encoding='utf-8') as file:
        return json.load(file)

def safe_save(name, data):
    ROOT.mkdir(mode=0o700,parents=True,exist_ok=True)
    fd,temp=tempfile.mkstemp(prefix='.moci-policy-',dir=str(ROOT))
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as file:
            os.fchmod(file.fileno(),0o600)
            json.dump(data,file,indent=2,sort_keys=True)
            file.write('\n')
            file.flush()
            os.fsync(file.fileno())
        os.replace(temp,ROOT/name)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)

def validate_image(image):
    if not IMAGE_RE.fullmatch(image):
        fatal('image must be a complete repository@sha256:<64 hexadecimal characters> reference')
    return image

def image_exists(image):
    result=subprocess.run(['/usr/bin/docker','image','inspect',image],stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL,timeout=15,check=False)
    return result.returncode==0

def prepare_app(name):
    if not ID_RE.fullmatch(name):
        fatal('invalid application ID')
    apps=load('app-catalog.json').get('apps',[])
    app=next((x for x in apps if x.get('id')==name),None)
    template=load('app-templates.json').get('templates',{}).get(name)
    if not app or not isinstance(template,dict) or app.get('risk') not in ('review',None):
        fatal('app lacks an approved low-risk deployment template')
    repo=template.get('repository')
    tag=template.get('image')
    if not isinstance(repo,str) or not isinstance(tag,str) or not tag.startswith(repo+':'):
        fatal('reviewed image reference is missing or malformed')
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._/-]*:[A-Za-z0-9][A-Za-z0-9._-]{0,80}',tag):
        fatal('invalid reviewed Docker image tag')
    # Explicitly approved source is in root-owned installer data, not client input.
    pull=subprocess.run(['/usr/bin/docker','pull',tag],
        stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,timeout=115,check=False)
    if pull.returncode!=0:
        fatal('Docker image pull failed; inspect Docker connectivity and registry access')
    inspect=subprocess.run(['/usr/bin/docker','image','inspect','--format','{{json .RepoDigests}}',tag],
        capture_output=True,text=True,timeout=12,check=False)
    if inspect.returncode!=0:
        fatal('Cannot inspect pulled image digest')
    try:
        digests=json.loads(inspect.stdout)
    except (ValueError,TypeError):
        fatal('Invalid registry digest response')
    digest=None
    for candidate in digests if isinstance(digests,list) else []:
        if not isinstance(candidate,str):continue
        normalized=candidate.removeprefix('docker.io/')
        if normalized.startswith(repo+'@') and IMAGE_RE.fullmatch(normalized):
            digest=normalized
            break
    if digest is None:
        fatal('No matching immutable repository digest returned by registry')
    if not image_exists(digest):
        fatal('Approved repository digest cannot be inspected locally')
    allowed=load('allowed-images.json')
    entries=allowed.get('images')
    if not isinstance(entries,list):fatal('Invalid allowlist data')
    allowed['images']=sorted(set(entries+[digest]))
    if len(allowed['images'])>100:fatal('Too many approved image digests')
    safe_save('allowed-images.json',allowed)
    pins=load('app-pins.json')
    if not isinstance(pins,dict):fatal('Invalid app pins')
    pins[name]=digest
    safe_save('app-pins.json',pins)
    return digest

# Only selected public registry hostnames can be targeted from the browser.
# Arbitrary registry URLs could turn the router into a privileged SSRF proxy.
CUSTOM_TAG=re.compile(r'^(?:(?:docker\.io|ghcr\.io|lscr\.io|quay\.io|registry\.gitlab\.com)/)?[a-z0-9][a-z0-9._/-]{2,95}:[A-Za-z0-9][A-Za-z0-9._-]{0,79}$')
def prepare_custom(image_tag):
    if not isinstance(image_tag,str) or not CUSTOM_TAG.fullmatch(image_tag):
        fatal('Image must be a public registry repository with a valid immutable-release tag')
    repository=image_tag.rsplit(':',1)[0]
    pull=subprocess.run(['/usr/bin/docker','pull',image_tag],capture_output=True,
                        text=True,timeout=150,check=False)
    if pull.returncode:
        fatal('Docker registry pull failed; check repository and network')
    inspect=subprocess.run(['/usr/bin/docker','image','inspect','--format','{{json .RepoDigests}}',image_tag],
                           capture_output=True,text=True,timeout=12,check=False)
    if inspect.returncode:fatal('Unable to inspect downloaded image')
    try:digests=json.loads(inspect.stdout)
    except (ValueError,TypeError):fatal('Malformed registry digest response')
    normalized_repo=repository.removeprefix('docker.io/')
    if '/' not in normalized_repo:
        normalized_repo='library/'+normalized_repo
    digest=None
    for candidate in digests if isinstance(digests,list) else []:
        if not isinstance(candidate,str):continue
        normalized=candidate.removeprefix('docker.io/')
        if normalized.startswith(normalized_repo+'@') and IMAGE_RE.fullmatch(normalized):
            digest=normalized
            break
    if digest is None:
        fatal('Docker did not return a verified matching immutable digest')
    if not image_exists(digest):fatal('Image digest cannot be inspected locally')
    data=load('allowed-images.json')
    entries=data.get('images')
    if not isinstance(entries,list) or len(entries)>99:fatal('Approved image list is full or invalid')
    data['images']=sorted(set(entries+[digest]))
    safe_save('allowed-images.json',data)
    return digest

def main(args):
    if os.geteuid()!=0:
        fatal('run as root on an isolated test router')
    if not args or args[0]=='help':
        print('Usage: moci-docker-policy status | prepare <app-id> | prepare-custom <repository:tag> | allow <repo@sha256:digest> | pin <app-id> <repo@sha256:digest> | enable | disable')
        return
    op=args[0]
    if op=='status' and len(args)==1:
        print('Writes:', 'enabled' if APPROVAL.exists() and APPROVAL.read_text().strip()=='enabled' else 'disabled')
        print('Allowed image digests:',len(load('allowed-images.json').get('images',[])))
        print('Pinned applications:',len(load('app-pins.json')))
        return
    if op=='prepare' and len(args)==2:
        print('Approved immutable digest:',prepare_app(args[1]))
        return
    if op=='prepare-custom' and len(args)==2:
        print('Approved immutable digest:',prepare_custom(args[1]))
        return
    if op=='allow' and len(args)==2:
        image=validate_image(args[1])
        if not image_exists(image):
            fatal('digest not present locally. Pull verified digest with: docker pull '+image)
        data=load('allowed-images.json')
        entries=data.get('images')
        if not isinstance(entries,list):
            fatal('invalid allowlist format')
        data['images']=sorted(set(entries+[image]))
        if len(data['images'])>100:
            fatal('allowlist limit exceeded')
        safe_save('allowed-images.json',data)
        print('Approved digest:',image)
        return
    if op=='pin' and len(args)==3:
        name,image=args[1],validate_image(args[2])
        if not ID_RE.fullmatch(name):
            fatal('invalid app ID')
        apps=load('app-catalog.json').get('apps',[])
        entry=next((app for app in apps if app.get('id')==name),None)
        if not entry or not entry.get('template_available'):
            fatal('app does not have a reviewed template')
        templates=load('app-templates.json').get('templates',{})
        template=templates.get(name)
        if not isinstance(template,dict) or template.get('repository')!=entry.get('repository'):
            fatal('app does not have an approved installation profile')
        if entry.get('risk') not in ('review',None):
            fatal('app is marked as security or router critical')
        if image.split('@',1)[0]!=entry.get('repository'):
            fatal('image repository does not match catalogue entry')
        if image not in load('allowed-images.json').get('images',[]):
            fatal('digest must be allowed before pinning')
        pins=load('app-pins.json')
        if not isinstance(pins,dict):
            fatal('invalid pins format')
        pins[name]=image
        safe_save('app-pins.json',pins)
        print('Pinned',name,'to',image)
        return
    if op=='enable' and len(args)==1:
        # Direct root action only; no ubus endpoint for altering this policy.
        fd=os.open(str(APPROVAL),os.O_CREAT|os.O_WRONLY|os.O_TRUNC,0o600)
        with os.fdopen(fd,'w',encoding='ascii') as file:
            os.fchmod(file.fileno(),0o600)
            file.write('enabled\n')
        print('RC deployment gate enabled. DO NOT USE ON PRODUCTION ROUTERS.')
        return
    if op=='disable' and len(args)==1:
        APPROVAL.unlink(missing_ok=True)
        print('RC deployment gate disabled')
        return
    fatal('invalid command or number of arguments')

if __name__=='__main__':
    main(sys.argv[1:])
