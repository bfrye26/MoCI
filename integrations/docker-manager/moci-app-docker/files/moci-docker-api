#!/usr/bin/env python3
"""MoCI Docker RPC adapter. Docker socket access stays on the router, not in JavaScript.

WARNING: Docker socket access is root-equivalent. Do not allow write operations
from a root-equivalent MoCI browser session. The deployment methods fail closed
until non-root rpcd permission isolation has passed live integration tests.
"""
import fcntl
import http.client
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import urllib.parse

DOCKER_SOCKET='/var/run/docker.sock'
ROOT='/etc/moci-docker'
STACKS='/srv/moci-docker/stacks'
MAX_REPLY=1024*1024
MAX_SPEC=16384
NAME=re.compile(r'^[a-z][a-z0-9-]{0,39}$')
IMAGE=re.compile(r'^[A-Za-z0-9][A-Za-z0-9._/-]*@sha256:[0-9a-f]{64}$')
CUSTOM_TAG=re.compile(r'^(?:(?:docker\.io|ghcr\.io|lscr\.io|quay\.io|registry\.gitlab\.com)/)?[a-z0-9][a-z0-9._/-]{2,95}:[A-Za-z0-9][A-Za-z0-9._-]{0,79}$')
IDENT=re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$|^[a-f0-9]{12,64}$')
READ_METHODS=['status','containers','stacks','images','volumes','networks','storage','logs','catalog','managed_stacks','diagnostics']
WRITE_METHODS=['deploy','prepare_app','prepare_custom','install_catalog','stack_action','container_action','volume_action','network_action','image_action']
# Deployments are opt-in: secure default for a router control plane.
# The root administrator must explicitly create this local-only enable file.
WRITES_ENABLED=False
ENABLE_FILE=ROOT+'/enable-deployments'
def writes_enabled():
    try:
        st=os.stat(ENABLE_FILE)
        return st.st_uid==0 and (st.st_mode & 0o022)==0 and open(ENABLE_FILE,encoding='ascii').read(32).strip()=='enabled'
    except (OSError,UnicodeError):
        return False


class UnixHTTP(http.client.HTTPConnection):
    def __init__(self):
        super().__init__('localhost',timeout=8)
    def connect(self):
        self.sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
        self.sock.settimeout(8)
        self.sock.connect(DOCKER_SOCKET)

def docker(method,path):
    conn=UnixHTTP()
    try:
        conn.request(method,'/v1.41'+path,headers={'Host':'docker'})
        res=conn.getresponse()
        body=res.read(MAX_REPLY+1)
        if len(body)>MAX_REPLY or res.status>=400:
            raise ValueError('Docker request failed')
        return json.loads(body) if body else {}
    finally: conn.close()

def ident(s):
    if not isinstance(s,str) or not IDENT.fullmatch(s):
        raise ValueError('Invalid Docker identifier')
    return urllib.parse.quote(s,safe='')

def policy():
    with open(ROOT+'/allowed-images.json',encoding='utf-8') as f:
        data=json.load(f)
    entries=data.get('images')
    if not isinstance(entries,list) or len(entries)>100 or any(not isinstance(i,str) or not IMAGE.fullmatch(i) for i in entries):
        raise ValueError('Invalid image policy')
    return set(entries)

def pins():
    with open(ROOT+'/app-pins.json',encoding='utf-8') as f:
        data=json.load(f)
    if not isinstance(data,dict) or any(not NAME.fullmatch(k) or not IMAGE.fullmatch(v) for k,v in data.items()):
        raise ValueError('Invalid approved application pins')
    return data

def template_specs():
    with open(ROOT+'/app-templates.json',encoding='utf-8') as f:
        data=json.load(f)
    if data.get('schema')!=1 or not isinstance(data.get('templates'),dict):
        raise ValueError('Invalid template catalogue')
    return data['templates']

def lan_ip():
    # Query kernel directly instead of depending on which BusyBox/iproute2
    # flags happen to be available in the selected OpenWrt image.
    sock=socket.socket(socket.AF_INET,socket.SOCK_DGRAM)
    try:
        raw=fcntl.ioctl(sock.fileno(),0x8915,b'br-lan'+bytes(250))
        ip=socket.inet_ntoa(raw[20:24])
    except OSError as exc:
        raise ValueError('LAN IPv4 address unavailable') from exc
    finally:
        sock.close()
    octets=[int(o) for o in ip.split('.')]
    if not (octets[0]==10 or (octets[0]==172 and 16<=octets[1]<=31)
            or (octets[0]==192 and octets[1]==168)):
        raise ValueError('LAN IPv4 address is not private')
    return ip

def catalog():
    with open(ROOT+'/app-catalog.json',encoding='utf-8') as f:
        data=json.load(f)
    if data.get('schema')!=1 or not isinstance(data.get('apps'),list):
        raise ValueError('Invalid catalogue')
    approved=policy()
    pinned=pins()
    templates=template_specs()
    apps=[]
    for app in data['apps'][:100]:
        appid=app.get('id')
        if not isinstance(appid,str) or not NAME.fullmatch(appid): continue
        image=pinned.get(appid)
        ready=bool(writes_enabled() and appid in templates and app.get('template_available') and app.get('risk') in ('review',None) and image in approved and image.split('@')[0]==app.get('repository')) if image else False
        can_prepare=bool(writes_enabled() and appid in templates and app.get('risk') in ('review',None) and app.get('template_available'))
        installed=os.path.isfile(STACKS+'/'+appid+'/compose.json')
        url=None
        if appid in templates and installed:
            raw_url=templates[appid].get('path')
            if isinstance(raw_url,str) and re.fullmatch(r'http://ROUTER_IP:[0-9]{4,5}/?',raw_url):
                try:url=raw_url.replace('ROUTER_IP',lan_ip())
                except ValueError:pass
        apps.append({k:app.get(k) for k in ('id','name','description','category','repository','profile','complexity','risk') } |
                    {'ready':ready,'can_prepare':can_prepare,'installed':installed,'url':url})
    return {'catalog':apps}

def spec_validate(spec, app_id=None):
    if not isinstance(spec,dict) or set(spec)!={'services'}:
        raise ValueError('Only services supported')
    services=spec['services']
    if not isinstance(services,dict) or not 1<=len(services)<=8:
        raise ValueError('Service count out of bounds')
    allow=policy()
    safe={}
    ports_used=set()
    named_volumes=set()
    for name,svc in services.items():
        if not isinstance(name,str) or not NAME.fullmatch(name) or not isinstance(svc,dict) or set(svc)-{'image','ports','volumes','environment','depends_on','mem_limit'}:
            raise ValueError('Unsupported Compose service')
        image=svc.get('image')
        if not isinstance(image,str) or image not in allow or not IMAGE.fullmatch(image):
            raise ValueError('Image digest not approved')
        ports=svc.get('ports',[])
        volumes=svc.get('volumes',[])
        if not isinstance(ports,list) or len(ports)>8 or not isinstance(volumes,list) or len(volumes)>4:
            raise ValueError('Invalid service mappings')
        for p in ports:
            if not isinstance(p,str) or not re.fullmatch(r'[0-9.]{7,15}:[0-9]{4,5}:[0-9]{1,5}',p):
                raise ValueError('Only explicit LAN IPv4 TCP ports allowed')
            if p.split(':',1)[0]!='127.0.0.1' and p.split(':',1)[0]!=lan_ip():
                raise ValueError('Ports can bind only to loopback or LAN interface')
            port=int(p.split(':')[1])
            if not 1024<=port<=65535 or port in ports_used:
                raise ValueError('Port not allowed or duplicated')
            ports_used.add(port)
        for v in volumes:
            if not isinstance(v,str) or not re.fullmatch(r'[a-z][a-z0-9_-]{0,39}:/[A-Za-z0-9_./-]{1,120}',v) or '..' in v.split(':')[1].split('/'):
                raise ValueError('Only named volumes with safe paths allowed')
            named_volumes.add(v.split(':',1)[0])
        environment=svc.get('environment',{})
        if not isinstance(environment,dict) or len(environment)>48:
            raise ValueError('Environment must contain no more than 48 key/value entries')
        for k,v in environment.items():
            if not isinstance(k,str) or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]{0,80}',k):
                raise ValueError('Invalid environment variable name')
            if not isinstance(v,(str,int,bool)) or len(str(v).encode('utf-8'))>2048:
                raise ValueError('Invalid environment variable value')
        dependencies=svc.get('depends_on',[])
        if not isinstance(dependencies,list) or len(dependencies)>7:
            raise ValueError('Invalid service dependencies')
        if any(not isinstance(x,str) or x not in services or x==name for x in dependencies):
            raise ValueError('Service dependency refers to an unknown or self service')
        requested_memory=svc.get('mem_limit','512m')
        if not isinstance(requested_memory,str) or not re.fullmatch(r'(?:[1-9][0-9]{0,3})[mMgG]',requested_memory):
            raise ValueError('Memory limit must use megabytes or gigabytes')
        mem_value=int(requested_memory[:-1])*(1024 if requested_memory[-1].lower()=='g' else 1)
        if mem_value<64 or mem_value>8192:
            raise ValueError('Memory limit must be between 64MB and 8GB')
        managed={'labels':{'com.moci.managed':'true'},'image':image,'ports':ports,'volumes':volumes,
                 'read_only':True,'user':'65534:65534','cap_drop':['ALL'],
                 'security_opt':['no-new-privileges:true'],'pids_limit':128,
                 'restart':'unless-stopped','mem_limit':requested_memory,
                 'environment':{key:str(value).lower() if isinstance(value,bool) else str(value)
                                for key,value in environment.items()}}
        if dependencies:managed['depends_on']=dependencies
        if app_id:
            approved_template=template_specs().get(app_id)
            if not isinstance(approved_template,dict) or app_id not in pins() or image!=pins()[app_id]:
                raise ValueError('Unapproved application profile')
            approved_ports=[lan_ip()+':'+x for x in approved_template.get('ports',[])]
            if sorted(ports)!=sorted(approved_ports) or sorted(volumes)!=sorted(approved_template.get('volumes',[])):
                raise ValueError('Application service differs from approved template')
            if approved_template.get('needs_write_access') is True:
                # Explicitly reviewed application requires writeable rootfs;
                # never allow this through arbitrary custom Compose.
                managed['read_only']=False
                managed.pop('user')
        safe[name]=managed
    return {'services':safe,'volumes':{key:{} for key in sorted(named_volumes)}}

def compose(name,arguments):
    base=STACKS+'/'+name
    # OpenWrt ships Compose both as Docker CLI plugin and standalone symlink.
    # Prefer the plugin and fall back to the standalone executable.
    plugin=subprocess.run(['/usr/bin/docker','compose','version'],
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=12,check=False)
    command=(['/usr/bin/docker','compose'] if plugin.returncode==0 else ['/usr/bin/docker-compose'])
    if command[0]=='/usr/bin/docker-compose' and not os.path.isfile(command[0]):
        raise ValueError('Docker Compose is not installed in the firmware')
    result=subprocess.run(command+['--project-name','moci-'+name,
        '--file',base+'/compose.json']+arguments,
        stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=180,
        env={'PATH':'/usr/bin:/bin','DOCKER_HOST':'unix:///var/run/docker.sock'},
        check=False)
    if result.returncode:
        error=result.stderr.decode('utf-8','replace')[-1000:]
        raise ValueError('Compose operation failed: '+error)
    return result.stdout[:4096].decode('utf-8','replace')

def deploy(name,raw,app_id=None):
    if not isinstance(name,str) or not NAME.fullmatch(name) or not isinstance(raw,str) or len(raw.encode())>MAX_SPEC:
        raise ValueError('Invalid stack deployment')
    value=json.dumps(spec_validate(json.loads(raw),app_id=app_id),indent=2,sort_keys=True).encode()
    root=STACKS+'/'+name
    os.makedirs(root,mode=0o700,exist_ok=True)
    with open(root+'/.lock','a+b') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        path=root+'/compose.json'
        if os.path.islink(path): raise ValueError('Unsafe stack path')
        before=open(path,'rb').read(MAX_SPEC+1) if os.path.exists(path) else None
        fd,tmp=tempfile.mkstemp(dir=root,prefix='.pending-')
        try:
            with os.fdopen(fd,'wb') as f:
                os.fchmod(f.fileno(),0o600);f.write(value);f.flush();os.fsync(f.fileno())
            os.replace(tmp,path)
            try: compose(name,['up','-d','--wait','--remove-orphans'])
            except Exception:
                if before is None: os.unlink(path)
                else:
                    with open(path,'wb') as f:f.write(before)
                raise
        finally:
            if os.path.exists(tmp): os.unlink(tmp)
    return {'deployed':True,'name':name}

def docker_json(method,path,payload=None):
    if method not in ('POST','DELETE'):
        raise ValueError('Unsupported Docker method')
    conn=UnixHTTP()
    try:
        body=json.dumps(payload).encode('utf-8') if payload is not None else None
        headers={'Host':'docker'}
        if body is not None:headers['Content-Type']='application/json'
        conn.request(method,'/v1.41'+path,body=body,headers=headers)
        res=conn.getresponse()
        raw=res.read(MAX_REPLY+1)
        if len(raw)>MAX_REPLY or res.status>=400:
            raise ValueError('Docker operation refused')
        return json.loads(raw) if raw else {'ok':True}
    finally:conn.close()

def managed_volume_action(name,action):
    if not isinstance(name,str) or not re.fullmatch(r'moci-[a-z][a-z0-9-]{1,40}',name):
        raise ValueError('Volumes must use moci- prefix')
    if action=='create':
        return docker_json('POST','/volumes/create',{'Name':name,
          'Labels':{'com.moci.managed':'true'}})
    if action=='remove':
        info=docker('GET','/volumes/'+urllib.parse.quote(name,safe=''))
        if (info.get('Labels') or {}).get('com.moci.managed')!='true':
            raise ValueError('Volume is not MoCI-managed')
        return docker_json('DELETE','/volumes/'+urllib.parse.quote(name,safe=''))
    raise ValueError('Unsupported volume action')

def managed_network_action(name,action):
    if not isinstance(name,str) or not re.fullmatch(r'moci-[a-z][a-z0-9-]{1,40}',name):
        raise ValueError('Networks must use moci- prefix')
    if action=='create':
        return docker_json('POST','/networks/create',{'Name':name,'Driver':'bridge',
          'Internal':True,'CheckDuplicate':True,
          'Labels':{'com.moci.managed':'true'}})
    if action=='remove':
        value=docker('GET','/networks/'+urllib.parse.quote(name,safe=''))
        if (value.get('Labels') or {}).get('com.moci.managed')!='true':
            raise ValueError('Network is not MoCI-managed')
        return docker_json('DELETE','/networks/'+urllib.parse.quote(name,safe=''))
    raise ValueError('Unsupported network action')

def managed_image_action(image_id,action):
    if action!='remove':
        raise ValueError('Unsupported image action')
    if not isinstance(image_id,str) or not re.fullmatch(r'sha256:[a-f0-9]{64}',image_id):
        raise ValueError('Invalid image identifier')
    # Docker refuses removal if images are used by active containers.
    return docker_json('DELETE','/images/'+urllib.parse.quote(image_id,safe=''))

def managed_container_action(cid,action):
    if action not in ('start','stop','restart','remove'):
        raise ValueError('Unknown container action')
    container=ident(cid)
    details=docker('GET','/containers/'+container+'/json')
    labels=(details.get('Config') or {}).get('Labels') or {}
    if labels.get('com.moci.managed')!='true':
        raise ValueError('Only MoCI-managed containers can be controlled')
    # Docker API requires POST for lifecycle controls, DELETE for managed removal.
    if action=='remove':
        return docker_json('DELETE','/containers/'+container+'?v=0&force=0')
    return docker_no_reply('POST','/containers/'+container+'/'+action+'?t=10')

def docker_no_reply(method,path):
    conn=UnixHTTP()
    try:
        conn.request(method,'/v1.41'+path,headers={'Host':'docker'})
        res=conn.getresponse()
        res.read(4096)
        if res.status not in (204,304):
            raise ValueError('Docker operation failed')
        return {'ok':True}
    finally:
        conn.close()

def diagnostics():
    checks=[]
    def report(name,ok,detail):
        checks.append({'name':name,'ok':bool(ok),'detail':str(detail)[:160]})
    try:
        info=docker('GET','/version')
        report('Docker Engine',bool(info.get('Version')),'Version '+str(info.get('Version','unknown')))
    except Exception:
        report('Docker Engine',False,'Daemon socket or service unavailable')
    try:
        docker_compose=subprocess.run(['/usr/bin/docker','compose','version'],
            stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=12,check=False)
        plugin_ok=docker_compose.returncode==0
    except (OSError,subprocess.SubprocessError):
        plugin_ok=False
    binary='/usr/bin/docker-compose'
    exists=plugin_ok or os.path.isfile(binary)
    report('Docker Compose',exists,'Installed' if exists else 'Missing Compose CLI plugin')
    if exists:
        try:
            command=['/usr/bin/docker','compose','version','--short'] if plugin_ok else [binary,'version','--short']
            process=subprocess.run(command,capture_output=True,
                text=True,timeout=8,check=False)
            report('Compose executable',process.returncode==0,
                (process.stdout or process.stderr).strip()[:100] if process.returncode==0 else 'Could not execute plugin')
        except (OSError,subprocess.SubprocessError):
            report('Compose executable',False,'Compose executable failed')
    for label,path in [('Stacks directory',STACKS),('Policy directory',ROOT)]:
        exists=os.path.isdir(path)
        report(label,exists,'Present' if exists else 'Not created yet')
    for label,name in [('Image allowlist','allowed-images.json'),('Approved image pins','app-pins.json'),
                       ('App catalogue','app-catalog.json'),('App templates','app-templates.json')]:
        try:
            with open(ROOT+'/'+name,encoding='utf-8') as source:
                json.load(source)
            report(label,True,'Valid JSON')
        except (OSError,ValueError):
            report(label,False,'Missing or invalid JSON')
    try:
        ip=lan_ip()
        report('LAN interface',True,ip)
    except ValueError:
        report('LAN interface',False,'No private br-lan IPv4 address')
    report('Deployment approval',writes_enabled(),
           'Explicitly enabled' if writes_enabled() else 'Read-only by default')
    return {'diagnostics':checks,'ready':all(x['ok'] for x in checks
            if x['name'] not in ('Deployment approval','Stacks directory'))}

def run(method,args):
    if method in WRITE_METHODS and not writes_enabled():
        raise ValueError('Deployment disabled pending non-root authentication verification')
    if method=='prepare_app':
        app_id=args.get('id')
        if not isinstance(app_id,str) or not NAME.fullmatch(app_id):
            raise ValueError('Invalid application ID')
        # CLI accepts only root-owned, reviewed templates; never arbitrary tags from browsers.
        command=subprocess.run(['/usr/sbin/moci-docker-policy','prepare',app_id],
                  capture_output=True,text=True,timeout=125,check=False)
        if command.returncode:
            raise ValueError('Application preparation failed; consult router logs')
        return {'prepared':True,'id':app_id}
    if method=='prepare_custom':
        tag=args.get('image')
        if not isinstance(tag,str) or len(tag)>150 or not CUSTOM_TAG.fullmatch(tag):
            raise ValueError('Invalid image tag')
        result=subprocess.run(['/usr/sbin/moci-docker-policy','prepare-custom',tag],
            stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=175,check=False)
        if result.returncode:
            raise ValueError('Image preparation failed; verify registry access and image tag')
        match=re.search(r'Approved immutable digest:\s*([A-Za-z0-9._/-]+@sha256:[0-9a-f]{64})',result.stdout)
        if not match or not IMAGE.fullmatch(match.group(1)):
            raise ValueError('No valid immutable digest returned')
        return {'prepared':True,'digest':match.group(1)}
    if method=='container_action':
        return managed_container_action(args.get('id'),args.get('action'))
    if method=='volume_action':
        return managed_volume_action(args.get('name'),args.get('action'))
    if method=='network_action':
        return managed_network_action(args.get('name'),args.get('action'))
    if method=='image_action':
        return managed_image_action(args.get('id'),args.get('action'))
    if method=='diagnostics':return diagnostics()
    if method=='status':
        try:
            v=docker('GET','/version')
            return {'available':True,'version':v.get('Version','?'),'read_only':not writes_enabled()}
        except Exception:
            return {'available':False,'message':'Docker Engine unavailable','read_only':True}
    if method=='catalog':return catalog()
    if method=='managed_stacks':
        return {'managed_stacks':[n for n in sorted(os.listdir(STACKS)) if NAME.fullmatch(n) and os.path.isfile(STACKS+'/'+n+'/compose.json')][:100]} if os.path.isdir(STACKS) else {'managed_stacks':[]}
    if method=='storage':
        result=[]
        for path in ('/','/overlay','/mnt/data'):
            if os.path.isdir(path):
                u=shutil.disk_usage(path)
                result.append({'Mount':path,'Total':u.total,'Used':u.used,'Free':u.free})
        return {'storage':result}
    if method=='containers':
        data=docker('GET','/containers/json?all=1')
        return {'containers':[{'Managed':(x.get('Labels') or {}).get('com.moci.managed')=='true','Id':x.get('Id',''),'Names':', '.join(n.lstrip('/') for n in x.get('Names',[])),'Image':x.get('Image',''),'State':x.get('State',''),'Status':x.get('Status','')} for x in data[:500]]}
    if method=='stacks':
        data=docker('GET','/containers/json?all=1')
        stacks={}
        for x in data[:500]:
            labels=x.get('Labels') or {}
            project=labels.get('com.docker.compose.project')
            if project and len(project)<100: stacks[project]=stacks.get(project,0)+1
        return {'stacks':[{'Name':n,'Containers':count} for n,count in stacks.items()]}
    if method=='images':
        return {'images':[{'Id':x.get('Id',''),'Tags':x.get('RepoTags') or [],'Size':x.get('Size',0)} for x in docker('GET','/images/json')[:500]]}
    if method=='volumes':
        return {'volumes':[{'Name':x.get('Name',''),'Driver':x.get('Driver','')} for x in (docker('GET','/volumes').get('Volumes') or [])[:500]]}
    if method=='networks':
        return {'networks':[{'Name':x.get('Name',''),'Driver':x.get('Driver','')} for x in docker('GET','/networks')[:500]]}
    if method=='logs':
        # No log access via arbitrary shell; use bounded Docker logs endpoint.
        x=ident(args.get('id'))
        conn=UnixHTTP()
        try:
            conn.request('GET','/v1.41/containers/'+x+'/logs?stdout=1&stderr=1&tail=100',headers={'Host':'docker'})
            res=conn.getresponse()
            if res.status>=400: raise ValueError('Docker logs unavailable')
            raw=res.read(65537)[:65536]
            return {'logs':raw.decode('utf-8','replace')}
        finally: conn.close()
    if method=='deploy':return deploy(args.get('name'),args.get('spec'))
    if method=='install_catalog':
        app_id=args.get('id')
        if not isinstance(app_id,str) or not NAME.fullmatch(app_id):
            raise ValueError('Invalid application ID')
        listing=catalog()['catalog']
        selected=next((a for a in listing if a['id']==app_id),None)
        if not selected or not selected['ready']:
            raise ValueError('Application requires approval before installation')
        image=pins()[app_id]
        template=template_specs().get(app_id)
        if not isinstance(template,dict) or template.get('repository')!=image.split('@',1)[0]:
            raise ValueError('Unapproved application template')
        mappings=template.get('ports',[])
        if not isinstance(mappings,list) or len(mappings)>8:
            raise ValueError('Invalid application ports')
        # Only the LAN IP can be bound: never 0.0.0.0 or WAN.
        ip=lan_ip()
        ports=[]
        for value in mappings:
            if not isinstance(value,str) or not re.fullmatch(r'[0-9]{4,5}:[0-9]{1,5}',value):
                raise ValueError('Invalid reviewed LAN port')
            ports.append(ip+':'+value)
        volumes=template.get('volumes',[])
        return deploy(app_id,json.dumps({'services':{'app':{'image':image,'ports':ports,'volumes':volumes}}}),app_id=app_id)

    if method=='stack_action':
        name=args.get('name');action=args.get('action')
        if not isinstance(name,str) or not NAME.fullmatch(name) or action not in ('start','stop','remove') or not os.path.isfile(STACKS+'/'+name+'/compose.json'):
            raise ValueError('Invalid managed stack operation')
        if action=='remove':
            # Remove managed containers and their network; retain named volumes
            # so uninstall does not silently destroy business data.
            compose(name,['down','--remove-orphans'])
            directory=STACKS+'/'+name
            path=directory+'/compose.json'
            if os.path.islink(path):
                raise ValueError('Unsafe Compose path')
            os.unlink(path)
        else:
            compose(name,{'start':['up','-d','--wait'],'stop':['stop']}[action])
        return {'ok':True,'name':name,'action':action,
                'data_preserved':action=='remove'}
    raise ValueError('Unknown method')

METHODS={k:({} if k not in ('logs','deploy','prepare_app','prepare_custom','install_catalog','stack_action','container_action','volume_action','network_action','image_action') else {'logs':{'id':'str'},'deploy':{'name':'str','spec':'str'},'prepare_app':{'id':'str'},'prepare_custom':{'image':'str'},'install_catalog':{'id':'str'},'stack_action':{'name':'str','action':'str'},'container_action':{'id':'str','action':'str'},'volume_action':{'name':'str','action':'str'},'network_action':{'name':'str','action':'str'},'image_action':{'id':'str','action':'str'}}[k]) for k in READ_METHODS+WRITE_METHODS}
if __name__=='__main__':
    if len(sys.argv)==2 and sys.argv[1]=='list':
        print(json.dumps(METHODS))
    elif len(sys.argv)==3 and sys.argv[1]=='call':
        try:
            args=json.load(sys.stdin)
            if not isinstance(args,dict):raise ValueError('Invalid RPC arguments')
            print(json.dumps(run(sys.argv[2],args)))
        except Exception:
            print(json.dumps({'error':'Operation denied or failed. Consult local router logs.'}))
    else:
        sys.exit(1)
